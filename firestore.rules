rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['id', 'full_name', 'created_at']) &&
        data.keys().hasOnly(['id', 'full_name', 'created_at']) &&
        data.id is string && data.id == request.auth.uid && isValidId(data.id) &&
        data.full_name is string && data.full_name.size() >= 1 && data.full_name.size() <= 120 &&
        data.created_at is string && data.created_at.size() <= 64;
    }

    function isValidWorkspace(data) {
      return data.keys().hasAll(['id', 'name', 'invite_code', 'created_by', 'created_at']) &&
        data.keys().hasOnly(['id', 'name', 'rate_per_unit', 'invite_code', 'created_by', 'created_at']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        (!('rate_per_unit' in data) || data.rate_per_unit == null || (data.rate_per_unit is number && data.rate_per_unit >= 0)) &&
        data.invite_code is string && data.invite_code.size() >= 4 && data.invite_code.size() <= 32 && data.invite_code.matches('^[A-Z0-9\\-]+$') &&
        isValidId(data.created_by) &&
        data.created_at is string && data.created_at.size() <= 64;
    }

    function isValidMember(data, workspaceId, memberId) {
      return data.keys().hasAll(['workspace_id', 'user_id', 'role', 'joined_at']) &&
        data.keys().hasOnly(['workspace_id', 'user_id', 'full_name', 'role', 'joined_at']) &&
        data.workspace_id == workspaceId &&
        data.user_id == memberId &&
        (!('full_name' in data) || (data.full_name is string && data.full_name.size() <= 120)) &&
        data.role in ['owner', 'member'] &&
        data.joined_at is string && data.joined_at.size() <= 64;
    }

    function isValidMeter(data, workspaceId, meterId) {
      return data.keys().hasAll(['id', 'workspace_id', 'name', 'initial_reading', 'sort_order', 'is_active', 'created_at']) &&
        data.keys().hasOnly(['id', 'workspace_id', 'name', 'initial_reading', 'sort_order', 'is_active', 'created_at']) &&
        data.id == meterId &&
        data.workspace_id == workspaceId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.initial_reading is number && data.initial_reading >= 0 &&
        data.sort_order is number &&
        data.is_active is bool &&
        data.created_at is string && data.created_at.size() <= 64;
    }

    function isValidBill(data, workspaceId, billId) {
      return data.keys().hasAll(['id', 'workspace_id', 'bill_date', 'rate_per_unit', 'total_units', 'total_amount', 'created_by', 'created_at']) &&
        data.keys().hasOnly(['id', 'workspace_id', 'bill_date', 'rate_per_unit', 'total_units', 'total_amount', 'created_by', 'created_by_name', 'created_at']) &&
        data.id == billId &&
        data.workspace_id == workspaceId &&
        data.bill_date is string && data.bill_date.size() >= 8 && data.bill_date.size() <= 20 &&
        data.rate_per_unit is number && data.rate_per_unit >= 0 &&
        data.total_units is number && data.total_units >= 0 &&
        data.total_amount is number && data.total_amount >= 0 &&
        isValidId(data.created_by) &&
        (!('created_by_name' in data) || (data.created_by_name is string && data.created_by_name.size() <= 120)) &&
        data.created_at is string && data.created_at.size() <= 64;
    }

    function isValidBillItem(data, workspaceId, billId, itemId) {
      return data.keys().hasAll(['id', 'bill_id', 'workspace_id', 'meter_name', 'previous_reading', 'current_reading', 'units', 'amount']) &&
        data.keys().hasOnly(['id', 'bill_id', 'workspace_id', 'meter_id', 'meter_name', 'previous_reading', 'current_reading', 'units', 'amount']) &&
        data.id == itemId &&
        data.bill_id == billId &&
        data.workspace_id == workspaceId &&
        (!('meter_id' in data) || data.meter_id == null || (data.meter_id is string && data.meter_id.size() <= 128)) &&
        data.meter_name is string && data.meter_name.size() >= 1 && data.meter_name.size() <= 120 &&
        data.previous_reading is number && data.previous_reading >= 0 &&
        data.current_reading is number && data.current_reading >= data.previous_reading &&
        data.units is number && data.units >= 0 &&
        data.amount is number && data.amount >= 0;
    }

    match /profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(userId) && userId == request.auth.uid && isValidProfile(incoming());
      allow update: if isVerifiedUser() && isValidId(userId) && userId == request.auth.uid && isValidProfile(incoming()) &&
        incoming().created_at == existing().created_at &&
        incoming().diff(existing()).affectedKeys().hasOnly(['full_name']);
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() && isValidId(workspaceId) && (existing().created_by == request.auth.uid || isWorkspaceMember(workspaceId));
      allow list: if isSignedIn() && existing().created_by == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(workspaceId) && isValidWorkspace(incoming()) && incoming().created_by == request.auth.uid;
      allow update: if isVerifiedUser() && isValidId(workspaceId) && isValidWorkspace(incoming()) &&
        incoming().created_by == existing().created_by &&
        incoming().created_at == existing().created_at &&
        isWorkspaceMember(workspaceId) &&
        (
          (incoming().diff(existing()).affectedKeys().hasOnly(['rate_per_unit', 'name'])) ||
          (isWorkspaceOwner(workspaceId) && incoming().diff(existing()).affectedKeys().hasOnly(['invite_code', 'name', 'rate_per_unit']))
        );
      allow delete: if isVerifiedUser() && isValidId(workspaceId) && isWorkspaceOwner(workspaceId);

      match /members/{memberId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(memberId) && (memberId == request.auth.uid || isWorkspaceMember(workspaceId));
        allow list: if isSignedIn() && existing().user_id == request.auth.uid;
        allow create: if isVerifiedUser() && isValidId(workspaceId) && isValidId(memberId) &&
          isValidMember(incoming(), workspaceId, memberId) &&
          exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
          (
            (memberId == request.auth.uid && incoming().role == 'owner' && get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.created_by == request.auth.uid) ||
            (memberId == request.auth.uid && incoming().role == 'member')
          );
        allow update: if isVerifiedUser() && isValidId(workspaceId) && isValidId(memberId) &&
          isValidMember(incoming(), workspaceId, memberId) &&
          incoming().workspace_id == existing().workspace_id &&
          incoming().user_id == existing().user_id &&
          incoming().role == existing().role &&
          incoming().joined_at == existing().joined_at &&
          memberId == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['full_name']);
        allow delete: if isVerifiedUser() && isValidId(workspaceId) && isValidId(memberId) &&
          (memberId == request.auth.uid || isWorkspaceOwner(workspaceId));
      }

      match /meters/{meterId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(meterId) && isWorkspaceMember(workspaceId);
        allow create: if isVerifiedUser() && isValidId(workspaceId) && isValidId(meterId) &&
          isValidMeter(incoming(), workspaceId, meterId) &&
          isWorkspaceMember(workspaceId);
        allow update: if isVerifiedUser() && isValidId(workspaceId) && isValidId(meterId) &&
          isValidMeter(incoming(), workspaceId, meterId) &&
          incoming().created_at == existing().created_at &&
          isWorkspaceMember(workspaceId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'initial_reading', 'sort_order', 'is_active']);
        allow delete: if isVerifiedUser() && isValidId(workspaceId) && isValidId(meterId) && isWorkspaceMember(workspaceId);
      }

      match /bills/{billId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(billId) && isWorkspaceMember(workspaceId);
        allow create: if isVerifiedUser() && isValidId(workspaceId) && isValidId(billId) &&
          isValidBill(incoming(), workspaceId, billId) &&
          incoming().created_by == request.auth.uid &&
          isWorkspaceMember(workspaceId);
        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(workspaceId) && isValidId(billId) && isWorkspaceMember(workspaceId);

        match /items/{itemId} {
          allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(billId) && isValidId(itemId) && isWorkspaceMember(workspaceId);
          allow create: if isVerifiedUser() && isValidId(workspaceId) && isValidId(billId) && isValidId(itemId) &&
            isValidBillItem(incoming(), workspaceId, billId, itemId) &&
            exists(/databases/$(database)/documents/workspaces/$(workspaceId)/bills/$(billId)) &&
            isWorkspaceMember(workspaceId);
          allow update: if false;
          allow delete: if isVerifiedUser() && isValidId(workspaceId) && isValidId(billId) && isValidId(itemId) && isWorkspaceMember(workspaceId);
        }
      }
    }
  }
}
